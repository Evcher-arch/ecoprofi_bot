[Unit]
Description=Ecoprofi: adjust Docker TCP MSS to VPS path MTU
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target
PartOf=docker.service

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/ecoprofi/deploy/docker-mss.sh apply
RemainAfterExit=yes
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target docker.service
