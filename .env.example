# Скопируйте в .env и заполните. Файл .env не попадает в git и в образ.

# --- БД (придумайте три разных пароля; латиница и цифры, без @ : / ?) ---
POSTGRES_PASSWORD=
BOT_DB_PASSWORD=
INDEXER_DB_PASSWORD=

# --- Служебный ключ между vk-adapter и bot (случайная строка от 32 символов) ---
SERVICE_KEY=

# --- T015. Yandex AI Studio: доступен bot и indexer ---
YANDEX_FOLDER_ID=
YANDEX_API_KEY=
YANDEX_DOC_EMBEDDING_MODEL=
YANDEX_QUERY_EMBEDDING_MODEL=
YANDEX_COMPLETION_MODEL=

# --- T017. Тестовое сообщество VK: доступно только vk-adapter ---
VK_GROUP_ID=
VK_GROUP_TOKEN=

# --- Подписка на клуб Экопрофи: доступна только bot ---
# Поиск отвечает только подписчикам клуба (VK Donut сообщества Экопрофи).
# Ключ доступа сообщества Экопрофи (Управление → Работа с API), выдаёт администратор.
# Без ключа bot не отвечает никому (HTTP 503).
CLUB_GROUP_TOKEN=
# Номер сообщества Экопрофи (по умолчанию 95098598).
# CLUB_GROUP_ID=
# Через сколько секунд перечитывать список подписчиков (по умолчанию 60).
# CLUB_CACHE_SECONDS=
# Допущенные к поиску без подписки — владелец и администраторы сообщества,
# у которых формально нет подписки: VK ID через запятую.
# CLUB_EXEMPT_IDS=
# Ссылка на оформление подписки: добавляется к ответу неподписчику (необязательно).
# CLUB_URL=

# --- Автономный индексатор (specs/003-autonomous-indexer) ---
# Номер приложения VK ID, через которое входит оператор.
VK_ID_APP=
# Идентификатор VK оператора: ему сообщество пишет оповещения.
# Оператор должен хотя бы раз написать сообществу.
ALERT_VK_USER_ID=
# Адрес расписания лекций (по умолчанию — статья сообщества).
# SCHEDULE_URL=
# Доля прежнего объёма платной ленты, ниже которой проход останавливается (по умолчанию 0.5).
# Платную ленту индексатор читает подпиской или правами оператора, а не участника.
# PAID_FEED_MIN_RATIO=

# --- Mini App (004): секрет только bot, никаких VITE_-секретов ---
MINIAPP_ENABLED=false
MINIAPP_APP_ID=
MINIAPP_APP_SECRET=
MINIAPP_PUBLIC_ORIGIN=

# Токены оператора VK сюда не вносятся: вход выполняется один раз командой
#   docker compose run --rm indexer python -m ecoprofi.indexer access login
# и доступ хранится на томе indexer-secrets, подключённом только к индексатору.
