# Скопируйте в .env и заполните. Файл .env не попадает в git и в образ.

# --- БД (придумайте три разных пароля; латиница и цифры, без @ : / ?) ---
POSTGRES_PASSWORD=
BOT_DB_PASSWORD=
INDEXER_DB_PASSWORD=

# --- Служебный ключ между vk-adapter и bot (случайная строка от 32 символов) ---
SERVICE_KEY=

# --- T015. Yandex AI Studio: доступен bot и indexer ---
YANDEX_FOLDER_ID=
YANDEX_API_KEY=
YANDEX_DOC_EMBEDDING_MODEL=
YANDEX_QUERY_EMBEDDING_MODEL=
YANDEX_COMPLETION_MODEL=

# --- T017. Тестовое сообщество VK: доступно только vk-adapter ---
VK_GROUP_ID=
VK_GROUP_TOKEN=

# --- Подписка на клуб Экопрофи: доступна только bot ---
# Поиск отвечает только подписчикам клуба (VK Donut сообщества Экопрофи).
# Ключ доступа сообщества Экопрофи (Управление → Работа с API), выдаёт администратор.
# Без ключа bot не отвечает никому (HTTP 503).
CLUB_GROUP_TOKEN=
# Номер сообщества Экопрофи (по умолчанию 95098598).
# CLUB_GROUP_ID=
# Через сколько секунд перечитывать список подписчиков (по умолчанию 60).
# CLUB_CACHE_SECONDS=
# Ссылка на оформление подписки: добавляется к ответу неподписчику (необязательно).
# CLUB_URL=

# Пользовательский токен оператора VK сюда не вносится:
# индексатор запрашивает его скрытым вводом при запуске.
